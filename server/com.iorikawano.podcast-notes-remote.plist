<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ログイン時にジョブサーバを自動起動する launchd 設定。

  インストール:
    cp server/com.iorikawano.podcast-notes-remote.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.iorikawano.podcast-notes-remote.plist

  停止:
    launchctl unload ~/Library/LaunchAgents/com.iorikawano.podcast-notes-remote.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.iorikawano.podcast-notes-remote</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/iorikawano/Documents/podcast-notes-automation/server/app.py</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/iorikawano/Documents/podcast-notes-automation</string>

	<key>EnvironmentVariables</key>
	<dict>
		<!-- claude / ffmpeg などを PATH から見つけられるようにする -->
		<key>PATH</key>
		<string>/Users/iorikawano/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/Users/iorikawano/Documents/podcast-notes-automation/logs/remote-server.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/iorikawano/Documents/podcast-notes-automation/logs/remote-server.err.log</string>
</dict>
</plist>
